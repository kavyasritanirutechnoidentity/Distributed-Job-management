# Required — random 32+ byte secret for JWT signing. No default is provided.
JWT_SECRET=replace-with-a-long-random-secret

# Initial admin account (seeded on first startup only)
ADMIN_PASSWORD=admin123

# Optional overrides
# DB_URL=jdbc:postgresql://127.0.0.1:5432/jobplatform
# DB_USER=jobplatform
# DB_PASSWORD=jobplatform
# JWT_TTL_MINUTES=60
# CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# TEMPORAL_SERVICE_TARGET=127.0.0.1:7233
